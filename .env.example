LIVEKIT_URL=
# Real addresses, simulated bookings. Missing key/errors retain dummy listings.
GOOGLE_PLACES_API_KEY=
HERE_API_KEY=
DOCTOR_SEARCH_PROVIDER=google
DOCTOR_SEARCH_MODE=auto
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ASSEMBLYAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ELEVENLABS_API_KEY=

# Development TTS uses LiveKit Inference credits (also in console mode).
# Set elevenlabs to use the existing direct ElevenLabs integration instead.
TTS_PROVIDER=cartesia_livekit
CARTESIA_MODEL=cartesia/sonic-3
CARTESIA_VOICE_ID=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

ASSEMBLYAI_MODEL=whisper-rt
GEMINI_MODEL=gemini-3.5-flash-lite
# Total completion budget includes reasoning and the final answer.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_COMPLETION_TOKENS=1024
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
FRONTEND_URL=http://localhost:5173
DEMO_MODE=false

# Console content logging contains report/conversation text.
CONSOLE_DEBUG=true
# Optional: absolute path to another development ReportContext JSON.
# REPORT_CONTEXT_PATH=
