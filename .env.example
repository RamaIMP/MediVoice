LIVEKIT_URL=
# Real addresses, simulated bookings. Missing key/errors retain dummy listings.
GOOGLE_PLACES_API_KEY=
HERE_API_KEY=
DOCTOR_SEARCH_PROVIDER=google
DOCTOR_SEARCH_MODE=auto
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ASSEMBLYAI_API_KEY=
GROQ_API_KEY=
ELEVENLABS_API_KEY=

# Direct Cartesia uses Cartesia credits, not LiveKit Inference credits.
# Other options: cartesia_livekit or elevenlabs (with their respective credentials).
TTS_PROVIDER=cartesia_direct
CARTESIA_API_KEY=
CARTESIA_MODEL=cartesia/sonic-3.6
CARTESIA_VOICE_ID=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

ASSEMBLYAI_MODEL=whisper-rt
# Groq handles routing, translation and safety review directly (no Gemini calls).
LANGUAGE_PROVIDER=groq
# BVC applies to LiveKit Cloud room audio, not local console capture.
BACKGROUND_VOICE_CANCELLATION=true
VAD_ACTIVATION_THRESHOLD=0.65
VAD_MIN_SPEECH_DURATION=0.12
INTERRUPTION_MIN_DURATION=0.65
# Total completion budget includes reasoning and the final answer.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_COMPLETION_TOKENS=1024
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
FRONTEND_URL=http://localhost:5173
DEMO_MODE=false

# Console content logging contains report/conversation text.
CONSOLE_DEBUG=true
# Optional: absolute path to another development ReportContext JSON.
# REPORT_CONTEXT_PATH=
